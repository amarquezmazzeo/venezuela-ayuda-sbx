# .npmrc – injected by venezuela-ayuda-secure sbx kit
# ────────────────────────────────────────────────────
# Supply-chain hardening settings.  These mirror the NPM_CONFIG_* env vars
# in spec.yaml; explicit file wins over env on some npm versions.

# Freeze installs to the exact lockfile tree (equivalent to `npm ci`)
prefer-frozen-lockfile=true
package-lock=true

# Never run lifecycle hooks during `npm install`.
# Individual packages that genuinely need a build step (e.g. native addons)
# must be explicitly allowed in .npmrc with:
#   //registry.npmjs.org/<pkg>:ignore-scripts=false
ignore-scripts=true

# Fail the install if any dependency has a known moderate+ vulnerability
audit-level=moderate

# Enforce https-only registry access (prevents MITM downgrade)
registry=https://registry.npmjs.org/
strict-ssl=true

# Verbose enough for CI but not noisy in interactive sessions
loglevel=warn

# Disable fund messages (noise in sandbox output)
fund=false

# Disable update notifier (network call)
update-notifier=false
